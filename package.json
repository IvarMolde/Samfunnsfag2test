{
  "name": "samfunnskunnskap-ovingsprove",
  "private": true,
  "description": "Øvingsprøve i samfunnskunnskap (A2). Statisk nettside og kilde til spørsmålsbanken.",
  "scripts": {
    "kontroll": "node sporsmalsbank/scripts/kvalitetskontroll.js",
    "xml": "node sporsmalsbank/scripts/bygg-xml.js",
    "appxml": "node sporsmalsbank/scripts/bygg-appxml.js",
    "docx": "node sporsmalsbank/scripts/bygg-docx.js",
    "prototype": "node sporsmalsbank/scripts/bygg-prototype.js",
    "bygg": "npm run kontroll && npm run xml && npm run appxml && npm run docx && npm run prototype",
    "validate": "node sporsmalsbank/scripts/validate.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "e2e": "node tests/e2e/e2e.mjs",
    "check": "npm run validate && npm test"
  },
  "devDependencies": {
    "@fontsource/lexend": "^5.3.0",
    "@xmldom/xmldom": "^0.8.10",
    "axe-core": "^4.13.0",
    "docx": "^9.0.0",
    "playwright-core": "^1.48.0"
  }
}
